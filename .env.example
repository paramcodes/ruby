# Local PostgreSQL (non-secret defaults; override as needed).
# `pnpm test:db` requires DATABASE_URL to be exported in the shell; it has no
# built-in default, so copy this value or run
# `export DATABASE_URL=postgres://wiki:wiki@localhost:5432/wiki`.
DATABASE_URL=postgres://wiki:wiki@localhost:5432/wiki

# Better Auth (generate a real secret with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
