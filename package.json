{
  "name": "individual-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "browserslist": [
    "chrome 123",
    "edge 123",
    "firefox 120",
    "safari 17.5"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "BETTER_AUTH_URL=http://127.0.0.1:3100 next dev --port 3100",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "REQUIRE_DB=1 vitest run",
    "test:e2e": "playwright test",
    "build": "next build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgres://wiki:wiki@localhost:5432/wiki} drizzle-kit generate",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgres://wiki:wiki@localhost:5432/wiki} drizzle-kit migrate",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-postgres://wiki:wiki@localhost:5432/wiki} tsx --conditions react-server src/server/db/seed.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm db:migrate && pnpm test:db && pnpm test:e2e"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
